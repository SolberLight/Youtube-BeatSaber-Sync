{
  "name": "ytbssync",
  "version": "0.2.0",
  "main": "dist/main/index.js",
  "description": "Match your YouTube Music liked songs to Beat Saber maps and download them",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "npm run dev:main && concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "fflate": "^0.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "youtubei.js": "^16.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.ytbssync.app",
    "productName": "YTBSSync",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "repo_assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "repo_assets/icon.icns",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "repo_assets/icon",
    "extraResources": [
      {
        "from": "repo_assets/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolberLight/Youtube-BeatSaber-Sync.git"
  }
}
